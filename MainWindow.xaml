<ui:FluentWindow x:Class="PhotoViewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        xmlns:local="clr-namespace:PhotoViewer"
        mc:Ignorable="d"
        PreviewKeyDown="Window_PreviewKeyDown"
        Title="照片瀏覽器"
        Height="900" Width="1500"
        WindowStartupLocation="CenterScreen"
        WindowBackdropType="None"
        Background="#FF0A0A0A"
        ExtendsContentIntoTitleBar="True"
        WindowCornerPreference="Round"
        Icon="pack://application:,,,/app.ico"
        AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver">
    <ui:FluentWindow.Resources>
        <!-- Apple 深色系配色 -->
        <SolidColorBrush x:Key="MacAccent" Color="#0A84FF"/>
        <SolidColorBrush x:Key="MacLabel" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="MacSecondaryLabel" Color="#98989D"/>
        <SolidColorBrush x:Key="MacCardBg" Color="#FF1C1C1E"/>
        <SolidColorBrush x:Key="MacHover" Color="#14FFFFFF"/>
        <SolidColorBrush x:Key="MacPhotoBg" Color="#FF000000"/>

        <!-- macOS 簡介面板式的資訊列：左灰標籤、右白值 -->
        <DataTemplate x:Key="InfoRowTemplate">
            <Grid Margin="14,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Label}" Foreground="{StaticResource MacSecondaryLabel}"
                           FontSize="12" TextWrapping="Wrap" VerticalAlignment="Top"/>
                <TextBlock Grid.Column="1" Text="{Binding Value}" Foreground="{StaticResource MacLabel}"
                           FontSize="12" TextWrapping="Wrap" VerticalAlignment="Top"
                           TextAlignment="Right"/>
            </Grid>
        </DataTemplate>

        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MacSecondaryLabel}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="16,0,16,6"/>
        </Style>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource MacCardBg}"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Margin" Value="12,0,12,14"/>
            <Setter Property="Padding" Value="0,8"/>
        </Style>
        <!-- 縮圖牆卡片（照片模式與看劇模式共用）。
             每張卡片外框固定 224×172（縮圖區 126 高 + 檔名固定兩行高），一行、兩行檔名的卡片一樣大，
             WrapPanel 才會排成整齊的格線。Button 的 Padding／邊框歸零、內容撐滿、靠上對齊，
             不讓任何元素把卡片撐大或在同一列上下錯位 -->
        <DataTemplate x:Key="GalleryCardTemplate">
            <ui:Button Appearance="Transparent" Padding="0" BorderThickness="0" Margin="8"
                       Width="224" Height="172"
                       HorizontalAlignment="Left" VerticalAlignment="Top"
                       HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                       CornerRadius="10" Cursor="Hand"
                       Click="Episode_Click" Tag="{Binding}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="126"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <!-- 縮圖區：ClipToBounds 只會裁成直角，改用與卡片同尺寸（224×126）的圓角 Clip -->
                    <Border Background="#FF1C1C1E" CornerRadius="10">
                        <Border.Clip>
                            <RectangleGeometry Rect="0,0,224,126" RadiusX="10" RadiusY="10"/>
                        </Border.Clip>
                        <Grid>
                            <TextBlock Text="{Binding Glyph}" FontSize="36"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <!-- UniformToFill 置中裁切（預設 Stretch 對齊時，比格子大的圖會從左上角裁） -->
                            <Image Source="{Binding Thumb}" Stretch="UniformToFill"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Border Background="#CC8E5A2B" CornerRadius="4" Padding="5,1" Margin="8"
                                    HorizontalAlignment="Left" VerticalAlignment="Top"
                                    Visibility="{Binding RawBadgeVisibility}">
                                <TextBlock Text="RAW" Foreground="White" FontSize="9" FontWeight="Bold"/>
                            </Border>
                        </Grid>
                    </Border>
                    <!-- 檔名：固定兩行高（行高 16 × 2），超過兩行以省略號結尾 -->
                    <TextBlock Grid.Row="1" Text="{Binding Name}" Foreground="White" FontSize="12"
                               Margin="4,7,4,0" Height="32" VerticalAlignment="Top"
                               LineHeight="16" LineStackingStrategy="BlockLineHeight"
                               TextWrapping="Wrap" TextTrimming="CharacterEllipsis" TextAlignment="Center"/>
                </Grid>
            </ui:Button>
        </DataTemplate>
        <!-- 卡片等大、間距一致；整個格線水平置中，左右留白對稱 -->
        <ItemsPanelTemplate x:Key="GalleryPanel">
            <WrapPanel HorizontalAlignment="Center"/>
        </ItemsPanelTemplate>
    </ui:FluentWindow.Resources>

    <Grid>
    <DockPanel>
        <!-- 標題列 -->
        <ui:TitleBar x:Name="AppTitleBar" DockPanel.Dock="Top" Title="wphoto" Height="36">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/app.ico"/>
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <!-- 工具列 -->
        <Grid x:Name="ToolbarRow" DockPanel.Dock="Top" Margin="12,2,12,8">
            <StackPanel Orientation="Horizontal">
                <ui:Button Content="{DynamicResource L.ChooseFolder}" Click="ChooseFolder_Click"
                           Appearance="Secondary" CornerRadius="8" Padding="12,6">
                    <ui:Button.Icon>
                        <ui:SymbolIcon Symbol="FolderOpen24"/>
                    </ui:Button.Icon>
                </ui:Button>
                <TextBlock x:Name="FolderLabel" Text="{DynamicResource L.NoFolderHint}"
                           Foreground="{StaticResource MacSecondaryLabel}" VerticalAlignment="Center"
                           Margin="12,0,0,0" FontSize="12"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock x:Name="SubtitleLabel" Text="{DynamicResource L.Subtitle}"
                           Foreground="{StaticResource MacSecondaryLabel}"
                           VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12" Visibility="Collapsed"/>
                <ComboBox x:Name="SubtitleSelect" MinWidth="170" MaxWidth="260" FontSize="12"
                          Visibility="Collapsed" DisplayMemberPath="Name" Margin="0,0,12,0"
                          SelectionChanged="SubtitleSelect_SelectionChanged"
                          DropDownOpened="SubtitleSelect_DropDownOpened"/>
                <ui:Button x:Name="EpisodesBtn" Click="EpisodesBtn_Click"
                           Visibility="Collapsed"
                           Appearance="Secondary" CornerRadius="8" Padding="12,6" Margin="0,0,12,0">
                    <ui:Button.Icon>
                        <ui:SymbolIcon Symbol="Grid24"/>
                    </ui:Button.Icon>
                </ui:Button>
                <ui:Button Content="{DynamicResource L.SwitchMode}" Click="SwitchMode_Click"
                           Appearance="Secondary" CornerRadius="8" Padding="12,6" Margin="0,0,12,0">
                    <ui:Button.Icon>
                        <ui:SymbolIcon Symbol="ArrowSwap24"/>
                    </ui:Button.Icon>
                </ui:Button>
                <ComboBox x:Name="LangSelect" FontSize="12" MinWidth="110"
                          SelectionChanged="LangSelect_SelectionChanged">
                    <ComboBoxItem Content="繁體中文" Tag="zh-Hant"/>
                    <ComboBoxItem Content="简体中文" Tag="zh-Hans"/>
                    <ComboBoxItem Content="English" Tag="en"/>
                </ComboBox>
            </StackPanel>
        </Grid>

        <!-- 狀態列 -->
        <Border x:Name="StatusBar" DockPanel.Dock="Bottom" Padding="14,6">
            <TextBlock x:Name="StatusLabel" Text="" Foreground="{StaticResource MacSecondaryLabel}"
                       FontSize="11" HorizontalAlignment="Center"/>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LeftCol" Width="250" MinWidth="180"/>
                <ColumnDefinition x:Name="LeftSplitCol" Width="4"/>
                <ColumnDefinition Width="*" MinWidth="400"/>
                <ColumnDefinition x:Name="RightSplitCol" Width="4"/>
                <ColumnDefinition x:Name="RightCol" Width="330" MinWidth="250"/>
            </Grid.ColumnDefinitions>

            <!-- 左側：類型篩選 + 檔案清單 -->
            <DockPanel Grid.Column="0">
                <ComboBox x:Name="TypeFilter" DockPanel.Dock="Top" Margin="8,0,4,8"
                          FontSize="12" SelectionChanged="TypeFilter_SelectionChanged"/>
                <ListBox x:Name="FileList"
                     Background="Transparent" BorderThickness="0"
                     Margin="8,0,4,8" FontSize="13"
                     SelectionChanged="FileList_SelectionChanged"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingPanel.IsVirtualizing="True">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Bd" Background="Transparent" CornerRadius="6"
                                            Padding="10,5" Margin="0,1">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource MacAccent}"/>
                                        </Trigger>
                                        <MultiTrigger>
                                            <MultiTrigger.Conditions>
                                                <Condition Property="IsMouseOver" Value="True"/>
                                                <Condition Property="IsSelected" Value="False"/>
                                            </MultiTrigger.Conditions>
                                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource MacHover}"/>
                                        </MultiTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <Border Background="#CC8E5A2B" CornerRadius="4" Padding="5,1" Margin="0,0,7,0"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding RawBadgeVisibility}">
                                <TextBlock Text="RAW" Foreground="White" FontSize="9" FontWeight="Bold"/>
                            </Border>
                            <Border Background="#CC2B5A8E" CornerRadius="4" Padding="5,1" Margin="0,0,7,0"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding VideoBadgeVisibility}">
                                <TextBlock Text="{DynamicResource L.VideoBadge}" Foreground="White"
                                           FontSize="9" FontWeight="Bold"/>
                            </Border>
                            <TextBlock Text="{Binding Name}" Foreground="{StaticResource MacLabel}"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="Transparent"/>

            <!-- 中間：影像（滾輪縮放、拖曳平移、雙擊還原）＋影片疊層控制列 -->
            <Border x:Name="CenterBorder" Grid.Column="2" Background="{StaticResource MacPhotoBg}"
                    CornerRadius="10" Margin="0,0,0,8">
                <Grid x:Name="ZoomHost" ClipToBounds="True" Background="Transparent"
                      MouseWheel="ZoomHost_MouseWheel"
                      MouseLeftButtonDown="ZoomHost_MouseLeftButtonDown"
                      MouseLeftButtonUp="ZoomHost_MouseLeftButtonUp"
                      MouseMove="ZoomHost_MouseMove">
                    <Image x:Name="MainImage" Stretch="Uniform" StretchDirection="DownOnly"
                           RenderOptions.BitmapScalingMode="HighQuality" Margin="10"
                           RenderTransformOrigin="0,0">
                        <Image.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="ImgScale"/>
                                <TranslateTransform x:Name="ImgPan"/>
                            </TransformGroup>
                        </Image.RenderTransform>
                    </Image>
                    <vlc:VideoView x:Name="VideoViewControl" Visibility="Collapsed" Margin="10">
                        <!-- 疊在影片上的前景層：偵測滑鼠移動、承載控制列（YouTube 式自動隱藏）。
                             背景 alpha=1：視覺上透明但可命中，否則滑鼠事件會穿透 -->
                        <Grid x:Name="VideoOverlay" Background="#01000000" Focusable="True"
                              MouseMove="VideoOverlay_MouseMove"
                              MouseLeftButtonDown="VideoOverlay_MouseDown"
                              PreviewKeyDown="Window_PreviewKeyDown">
                            <!-- 封面選集：疊在影片視窗上，影片視窗保持存在，點封面播放才不會卡。
                                 底色包在 Border 上（WPF-UI 的 ScrollViewer 樣板不畫 Background） -->
                            <Border x:Name="EpisodePicker" Visibility="Collapsed" Background="#FF121214">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
                                    <ItemsControl x:Name="EpisodeList"
                                                  ItemTemplate="{StaticResource GalleryCardTemplate}"
                                                  ItemsPanel="{StaticResource GalleryPanel}"/>
                                </ScrollViewer>
                            </Border>
                            <Border x:Name="VideoControls" VerticalAlignment="Bottom"
                                    Margin="18,0,18,14" Background="#E6141416"
                                    CornerRadius="10" Padding="12,8" Visibility="Collapsed">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ui:Button x:Name="PlayPauseBtn" Grid.Column="0" Appearance="Transparent"
                                               Click="PlayPause_Click" Padding="6" CornerRadius="6">
                                        <ui:Button.Icon>
                                            <ui:SymbolIcon x:Name="PlayPauseIcon" Symbol="Pause24" Foreground="White"/>
                                        </ui:Button.Icon>
                                    </ui:Button>
                                    <TextBlock x:Name="TimeCurrent" Grid.Column="1" Text="0:00:00"
                                               Foreground="#CCCCCC" FontSize="12"
                                               VerticalAlignment="Center" Margin="8,0"/>
                                    <Slider x:Name="PositionSlider" Grid.Column="2" VerticalAlignment="Center"
                                            Minimum="0" Maximum="1000" IsMoveToPointEnabled="True"
                                            ValueChanged="PositionSlider_ValueChanged"/>
                                    <TextBlock x:Name="TimeTotal" Grid.Column="3" Text="0:00:00"
                                               Foreground="#CCCCCC" FontSize="12"
                                               VerticalAlignment="Center" Margin="8,0"/>
                                    <ComboBox x:Name="SpeedSelect" Grid.Column="4" FontSize="12" MinWidth="80"
                                              Margin="4,0" SelectedIndex="2"
                                              SelectionChanged="SpeedSelect_SelectionChanged">
                                        <ComboBoxItem Content="0.5x"/>
                                        <ComboBoxItem Content="0.75x"/>
                                        <ComboBoxItem Content="1.0x"/>
                                        <ComboBoxItem Content="1.25x"/>
                                        <ComboBoxItem Content="1.5x"/>
                                        <ComboBoxItem Content="2.0x"/>
                                    </ComboBox>
                                    <ui:Button Grid.Column="5" Appearance="Transparent" Click="Fullscreen_Click"
                                               Padding="6" CornerRadius="6"
                                               ToolTip="{DynamicResource L.FullscreenTip}">
                                        <ui:Button.Icon>
                                            <ui:SymbolIcon Symbol="FullScreenMaximize24" Foreground="White"/>
                                        </ui:Button.Icon>
                                    </ui:Button>
                                </Grid>
                            </Border>
                        </Grid>
                    </vlc:VideoView>
                    <!-- 照片模式縮圖牆（看劇模式的選集在 VideoView 疊層內，因為影片視窗必須保持存在） -->
                    <Border x:Name="PhotoGrid" Visibility="Collapsed" Background="#FF121214">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
                            <ItemsControl x:Name="PhotoGridList"
                                          ItemTemplate="{StaticResource GalleryCardTemplate}"
                                          ItemsPanel="{StaticResource GalleryPanel}"/>
                        </ScrollViewer>
                    </Border>
                    <ui:ProgressRing x:Name="LoadingRing" IsIndeterminate="True" Width="44" Height="44"
                                     Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <TextBlock x:Name="PlaceholderText" Text="{DynamicResource L.PlaceholderPhoto}"
                               Foreground="#5A5A5E" FontSize="17"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="3" HorizontalAlignment="Stretch" Background="Transparent"/>

            <!-- 右側：資訊面板（macOS 簡介風卡片） -->
            <ScrollViewer Grid.Column="4" VerticalScrollBarVisibility="Auto" Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock Text="{DynamicResource L.ShootingInfo}" Style="{StaticResource CardTitle}" Margin="26,4,16,6"/>
                    <Border Style="{StaticResource Card}">
                        <ItemsControl x:Name="FileInfoList" ItemTemplate="{StaticResource InfoRowTemplate}"/>
                    </Border>
                    <TextBlock x:Name="KeyTitle" Text="{DynamicResource L.KeyParams}" Style="{StaticResource CardTitle}"
                               Margin="26,0,16,6" Visibility="Collapsed"/>
                    <Border x:Name="KeyCard" Style="{StaticResource Card}" Visibility="Collapsed">
                        <ItemsControl x:Name="KeyInfoList" ItemTemplate="{StaticResource InfoRowTemplate}"/>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>

    <!-- 啟動模式選單（避開標題列，讓視窗仍可拖曳與關閉） -->
    <Grid x:Name="ModeOverlay" Background="#FF0A0A0A" Margin="0,36,0,0">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="wphoto" FontSize="36" FontWeight="Bold" Foreground="White"
                       HorizontalAlignment="Center"/>
            <TextBlock Text="{DynamicResource L.ChooseMode}" FontSize="14" Foreground="{StaticResource MacSecondaryLabel}"
                       HorizontalAlignment="Center" Margin="0,8,0,32"/>
            <StackPanel Orientation="Horizontal">
                <ui:Button Click="PhotoMode_Click" Width="220" Height="180" Margin="0,0,24,0"
                           Appearance="Secondary" CornerRadius="14" Cursor="Hand">
                    <StackPanel>
                        <TextBlock Text="🖼️" FontSize="52" HorizontalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource L.PhotoMode}" FontSize="17" FontWeight="SemiBold" Foreground="White"
                                   HorizontalAlignment="Center" Margin="0,12,0,4"/>
                        <TextBlock Text="{DynamicResource L.PhotoModeDesc}" FontSize="11"
                                   Foreground="{StaticResource MacSecondaryLabel}" HorizontalAlignment="Center"/>
                    </StackPanel>
                </ui:Button>
                <ui:Button Click="VideoMode_Click" Width="220" Height="180"
                           Appearance="Secondary" CornerRadius="14" Cursor="Hand">
                    <StackPanel>
                        <TextBlock Text="🎬" FontSize="52" HorizontalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource L.VideoMode}" FontSize="17" FontWeight="SemiBold" Foreground="White"
                                   HorizontalAlignment="Center" Margin="0,12,0,4"/>
                        <TextBlock Text="{DynamicResource L.VideoModeDesc}" FontSize="11"
                                   Foreground="{StaticResource MacSecondaryLabel}" HorizontalAlignment="Center"/>
                    </StackPanel>
                </ui:Button>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,30,0,0">
                <ui:Button Content="繁體中文" Tag="zh-Hant" Click="OverlayLang_Click"
                           Appearance="Transparent" FontSize="12" Padding="10,4" Margin="4,0"/>
                <ui:Button Content="简体中文" Tag="zh-Hans" Click="OverlayLang_Click"
                           Appearance="Transparent" FontSize="12" Padding="10,4" Margin="4,0"/>
                <ui:Button Content="English" Tag="en" Click="OverlayLang_Click"
                           Appearance="Transparent" FontSize="12" Padding="10,4" Margin="4,0"/>
            </StackPanel>
        </StackPanel>
    </Grid>
    </Grid>
</ui:FluentWindow>
