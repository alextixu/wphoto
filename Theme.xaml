<!--
    電影院配色（與 iOS 版 ios/wphoto/Shared/Theme.swift 同一套色票）。

    概念是「熄燈後的放映廳」：畫面裡唯一的彩色是座椅與布幕的絨布紅，其餘都是暖黑與象牙白，
    讓海報、照片本身成為最亮的東西。紅色對深色底的對比只有 3.3:1，夠當圖示與填色、不夠當小字，
    所以文字一律用象牙白系列；紅色只留給「播放、進度、主要動作」。

    這個檔案在 App.xaml 裡排在 WPF-UI 的字典後面，同名的 key 會蓋過 WPF-UI 預設的藍色與冷灰。
    WPF-UI 的控制項都用 DynamicResource 取筆刷，所以只要在這裡重新定義同名筆刷就會生效。
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ========== 色票 ========== -->
    <!-- 全頁底色：帶一點暖意的黑，不用死黑 -->
    <Color x:Key="Wp.BackgroundColor">#0E0B0A</Color>
    <!-- 卡片表面 -->
    <Color x:Key="Wp.CardColor">#1C1716</Color>
    <!-- 比卡片再亮一階：疊在卡片上的控制項、圖示底塊、選取的列 -->
    <Color x:Key="Wp.SurfaceColor">#2A2322</Color>
    <!-- 絨布紅：全 App 唯一的彩色，象牙白字壓在上面的對比是 5.3:1 -->
    <Color x:Key="Wp.AccentColor">#C8313A</Color>
    <Color x:Key="Wp.AccentHoverColor">#D23D46</Color>
    <Color x:Key="Wp.AccentPressedColor">#A8282F</Color>
    <!-- 深絨布紅：大面積用（首頁看劇卡），比強調紅暗才不會刺眼 -->
    <Color x:Key="Wp.VelvetColor">#5C121C</Color>
    <Color x:Key="Wp.VelvetDeepColor">#2E0A10</Color>
    <!-- 次要的底色（RAW 徽章） -->
    <Color x:Key="Wp.MutedColor">#5A504A</Color>
    <!-- 文字三階層 -->
    <Color x:Key="Wp.LabelColor">#F2ECE4</Color>
    <Color x:Key="Wp.SecondaryLabelColor">#A89F97</Color>
    <Color x:Key="Wp.TertiaryLabelColor">#8A8079</Color>
    <Color x:Key="Wp.DisabledLabelColor">#5CF2ECE4</Color>
    <!-- 列與列之間的分隔線（象牙白 8%）、卡片邊框（象牙白 10%） -->
    <Color x:Key="Wp.SeparatorColor">#14F2ECE4</Color>
    <Color x:Key="Wp.StrokeColor">#1AF2ECE4</Color>
    <!-- 滑鼠停留的反白（象牙白 6%／9%／4%） -->
    <Color x:Key="Wp.HoverColor">#0FF2ECE4</Color>
    <Color x:Key="Wp.ControlColor">#17F2ECE4</Color>
    <Color x:Key="Wp.ControlPressedColor">#0AF2ECE4</Color>

    <SolidColorBrush x:Key="Wp.Background" Color="{StaticResource Wp.BackgroundColor}" />
    <SolidColorBrush x:Key="Wp.Card" Color="{StaticResource Wp.CardColor}" />
    <SolidColorBrush x:Key="Wp.Surface" Color="{StaticResource Wp.SurfaceColor}" />
    <SolidColorBrush x:Key="Wp.Accent" Color="{StaticResource Wp.AccentColor}" />
    <SolidColorBrush x:Key="Wp.Muted" Color="{StaticResource Wp.MutedColor}" />
    <SolidColorBrush x:Key="Wp.Label" Color="{StaticResource Wp.LabelColor}" />
    <SolidColorBrush x:Key="Wp.SecondaryLabel" Color="{StaticResource Wp.SecondaryLabelColor}" />
    <SolidColorBrush x:Key="Wp.TertiaryLabel" Color="{StaticResource Wp.TertiaryLabelColor}" />
    <SolidColorBrush x:Key="Wp.Separator" Color="{StaticResource Wp.SeparatorColor}" />
    <SolidColorBrush x:Key="Wp.Stroke" Color="{StaticResource Wp.StrokeColor}" />
    <SolidColorBrush x:Key="Wp.HoverFill" Color="{StaticResource Wp.HoverColor}" />
    <!-- 疊在影片上的面板（控制列、續播提示）：卡片色 92% -->
    <SolidColorBrush x:Key="Wp.OverlayPanel" Color="#EB1C1716" />
    <!-- 進度條的底軌（象牙白 18%） -->
    <SolidColorBrush x:Key="Wp.ProgressTrack" Color="#2EF2ECE4" />
    <!-- 照片與影片的畫布：純黑，不影響看照片的色偏判斷 -->
    <SolidColorBrush x:Key="Wp.Canvas" Color="#000000" />
    <!-- 壓在深紅絨布上的次要字：灰字對比不足，改用半透明象牙白 -->
    <SolidColorBrush x:Key="Wp.LabelOnVelvet" Color="#BFF2ECE4" />

    <!-- 全頁背景：上淺下深的微漸層，讓卡片不會貼在死黑上 -->
    <LinearGradientBrush x:Key="Wp.Backdrop" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#171211" />
        <GradientStop Offset="1" Color="#0A0807" />
    </LinearGradientBrush>
    <!-- 畫面上方一抹很淡的紅光，像布幕映出來的（首頁與看劇模式；照片模式不開） -->
    <RadialGradientBrush x:Key="Wp.Glow" Center="0.5,0" GradientOrigin="0.5,0" RadiusX="0.75" RadiusY="0.7">
        <GradientStop Offset="0" Color="#525C121C" />
        <GradientStop Offset="1" Color="#005C121C" />
    </RadialGradientBrush>
    <!-- 深紅絨布的表面（首頁看劇卡） -->
    <LinearGradientBrush x:Key="Wp.Velvet" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="{StaticResource Wp.VelvetColor}" />
        <GradientStop Offset="1" Color="{StaticResource Wp.VelvetDeepColor}" />
    </LinearGradientBrush>
    <!-- 沒有封面的海報：深色片框，不用彩色（沒封面的片一多，整面牆就花了） -->
    <LinearGradientBrush x:Key="Wp.PosterPlaceholder" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="{StaticResource Wp.SurfaceColor}" />
        <GradientStop Offset="1" Color="{StaticResource Wp.CardColor}" />
    </LinearGradientBrush>
    <!-- 影片縮圖底部壓暗：進度條疊在亮畫面上也看得清 -->
    <LinearGradientBrush x:Key="Wp.ThumbShade" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0.5" Color="#00000000" />
        <GradientStop Offset="1" Color="#99000000" />
    </LinearGradientBrush>

    <!-- 陰影：只掛在「空的」底板上，不掛在有字的元素上（WPF 的 Effect 會讓裡面的字失去 ClearType） -->
    <DropShadowEffect x:Key="Wp.CardShadow" BlurRadius="28" ShadowDepth="8" Direction="270" Opacity="0.5" Color="Black" />
    <DropShadowEffect x:Key="Wp.PosterShadow" BlurRadius="18" ShadowDepth="6" Direction="270" Opacity="0.55" Color="Black" />
    <DropShadowEffect x:Key="Wp.TileShadow" BlurRadius="12" ShadowDepth="4" Direction="270" Opacity="0.35" Color="Black" />

    <!-- 標題字：拉丁字母用 Georgia 襯線；中文字沒有在 Georgia 裡，會退回系統的中文字型（與 iOS 相同：New York + 蘋方） -->
    <FontFamily x:Key="Wp.SerifFont">Georgia</FontFamily>

    <!-- ========== 文字樣式 ========== -->
    <Style x:Key="Wp.TitleText" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{StaticResource Wp.SerifFont}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource Wp.Label}" />
    </Style>
    <!-- 分區標題：小字、次要色，比粗體大字沉穩 -->
    <Style x:Key="Wp.SectionTitle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Wp.SecondaryLabel}" />
    </Style>

    <!-- ========== 按鈕樣式 ========== -->
    <!-- 卡片類按鈕（海報、縮圖、模式卡）：滑鼠停留時略微浮起放大，按下略暗。外觀全部由內容自己畫 -->
    <Style x:Key="Wp.CardButton" TargetType="{x:Type Button}">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Grid x:Name="Root" Background="Transparent" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <ScaleTransform x:Name="Scale" ScaleX="1" ScaleY="1" />
                        </Grid.RenderTransform>
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleX" To="1.03" Duration="0:0:0.15" />
                                        <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleY" To="1.03" Duration="0:0:0.15" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.2" />
                                        <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.2" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Opacity" Value="0.85" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 清單列按鈕（繼續觀看、最近位置）：滑鼠停留時整列淡淡反白，不放大 -->
    <Style x:Key="Wp.RowButton" TargetType="{x:Type Button}">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Grid x:Name="Root" Background="Transparent">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        <Border x:Name="Highlight" CornerRadius="10" Background="{StaticResource Wp.HoverFill}"
                                Opacity="0" IsHitTestVisible="False" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Highlight" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Opacity" Value="0.85" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 疊在影片上的膠囊按鈕（續播提示的「從頭播放」）：象牙白實心、深色字，霧面底上一眼看得出可以按 -->
    <Style x:Key="Wp.PillButton" TargetType="{x:Type Button}">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{StaticResource Wp.Background}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Bd" CornerRadius="14" Background="{StaticResource Wp.Label}" Padding="12,5">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#FFFFFFFF" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.8" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ========== 蓋過 WPF-UI 的強調色（預設 #0078D4 藍） ========== -->
    <Color x:Key="SystemAccentColor">#C8313A</Color>
    <Color x:Key="SystemAccentColorPrimary">#C8313A</Color>
    <Color x:Key="SystemAccentColorSecondary">#C8313A</Color>
    <Color x:Key="SystemAccentColorTertiary">#A8282F</Color>
    <SolidColorBrush x:Key="SystemAccentColorBrush" Color="{StaticResource Wp.AccentColor}" />
    <SolidColorBrush x:Key="SystemAccentColorPrimaryBrush" Color="{StaticResource Wp.AccentColor}" />
    <SolidColorBrush x:Key="SystemAccentColorSecondaryBrush" Color="{StaticResource Wp.AccentColor}" />
    <SolidColorBrush x:Key="SystemAccentColorTertiaryBrush" Color="{StaticResource Wp.AccentPressedColor}" />
    <SolidColorBrush x:Key="SystemFillColorAttentionBrush" Color="{StaticResource Wp.AccentColor}" />
    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="{StaticResource Wp.AccentColor}" />
    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="{StaticResource Wp.AccentHoverColor}" />
    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="{StaticResource Wp.AccentPressedColor}" />
    <!-- 「強調色文字」（超連結等）：紅字對比不足，改用象牙白 -->
    <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="{StaticResource Wp.LabelColor}" />
    <SolidColorBrush x:Key="AccentTextFillColorSecondaryBrush" Color="{StaticResource Wp.SecondaryLabelColor}" />
    <SolidColorBrush x:Key="AccentTextFillColorTertiaryBrush" Color="{StaticResource Wp.SecondaryLabelColor}" />
    <!-- 選取文字的底色：深絨布紅 + 象牙白字 -->
    <SolidColorBrush x:Key="AccentFillColorSelectedTextBackgroundBrush" Color="{StaticResource Wp.VelvetColor}" />

    <!-- 主要按鈕（Appearance=Primary）：紅底象牙白字 -->
    <SolidColorBrush x:Key="AccentButtonBackground" Color="{StaticResource Wp.AccentColor}" />
    <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="{StaticResource Wp.AccentHoverColor}" />
    <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="{StaticResource Wp.AccentPressedColor}" />
    <SolidColorBrush x:Key="AccentButtonForeground" Color="{StaticResource Wp.LabelColor}" />
    <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="{StaticResource Wp.LabelColor}" />
    <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="#CCF2ECE4" />

    <!-- ========== 蓋過 WPF-UI 的冷灰：文字、背景、控制項 ========== -->
    <SolidColorBrush x:Key="ApplicationBackgroundBrush" Color="{StaticResource Wp.BackgroundColor}" />
    <SolidColorBrush x:Key="WindowBackground" Color="{StaticResource Wp.BackgroundColor}" />
    <SolidColorBrush x:Key="WindowForeground" Color="{StaticResource Wp.LabelColor}" />
    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="{StaticResource Wp.LabelColor}" />
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="{StaticResource Wp.SecondaryLabelColor}" />
    <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="{StaticResource Wp.TertiaryLabelColor}" />
    <SolidColorBrush x:Key="TextFillColorDisabledBrush" Color="{StaticResource Wp.DisabledLabelColor}" />
    <SolidColorBrush x:Key="TextPlaceholderColorBrush" Color="{StaticResource Wp.TertiaryLabelColor}" />
    <SolidColorBrush x:Key="LabelForeground" Color="{StaticResource Wp.SecondaryLabelColor}" />

    <!-- 鍵盤焦點框：WPF-UI 的圓角框，改成半透明象牙白 -->
    <SolidColorBrush x:Key="KeyboardFocusBorderColorBrush" Color="#8CF2ECE4" />
    <SolidColorBrush x:Key="FocusStrokeColorOuterBrush" Color="{StaticResource Wp.LabelColor}" />
    <SolidColorBrush x:Key="FocusStrokeColorInnerBrush" Color="#B30E0B0A" />

    <!-- 一般按鈕（Appearance=Secondary／Transparent 的停留色）：象牙白半透明，疊在暖黑上是暖灰 -->
    <SolidColorBrush x:Key="ButtonBackground" Color="{StaticResource Wp.ControlColor}" />
    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#21F2ECE4" />
    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="{StaticResource Wp.ControlPressedColor}" />
    <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="{StaticResource Wp.ControlPressedColor}" />
    <SolidColorBrush x:Key="ButtonForeground" Color="{StaticResource Wp.LabelColor}" />
    <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="{StaticResource Wp.LabelColor}" />
    <SolidColorBrush x:Key="ButtonForegroundPressed" Color="{StaticResource Wp.SecondaryLabelColor}" />
    <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="{StaticResource Wp.DisabledLabelColor}" />
    <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="{StaticResource Wp.StrokeColor}" />
    <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="{StaticResource Wp.StrokeColor}" />
    <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="{StaticResource Wp.ControlColor}" />
    <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#21F2ECE4" />
    <SolidColorBrush x:Key="ControlFillColorTertiaryBrush" Color="{StaticResource Wp.ControlPressedColor}" />
    <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush" Color="{StaticResource Wp.HoverColor}" />
    <SolidColorBrush x:Key="SubtleFillColorTertiaryBrush" Color="{StaticResource Wp.ControlPressedColor}" />
    <SolidColorBrush x:Key="MenuBarItemBackgroundSelected" Color="{StaticResource Wp.HoverColor}" />
    <!-- 控制項的立體邊框（WPF-UI 是冷灰漸層）：改成單色的象牙白細框 -->
    <SolidColorBrush x:Key="ControlElevationBorderBrush" Color="{StaticResource Wp.StrokeColor}" />
    <SolidColorBrush x:Key="AccentControlElevationBorderBrush" Color="#1A000000" />
    <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="{StaticResource Wp.StrokeColor}" />
    <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="{StaticResource Wp.StrokeColor}" />
    <SolidColorBrush x:Key="DividerStrokeColorDefaultBrush" Color="{StaticResource Wp.SeparatorColor}" />
    <SolidColorBrush x:Key="SurfaceStrokeColorDefaultBrush" Color="{StaticResource Wp.StrokeColor}" />
    <SolidColorBrush x:Key="SurfaceStrokeColorFlyoutBrush" Color="{StaticResource Wp.StrokeColor}" />

    <!-- 下拉選單：選取項目左側的小色條是紅（填色），清單底是卡片色 -->
    <SolidColorBrush x:Key="ComboBoxBackground" Color="{StaticResource Wp.ControlColor}" />
    <SolidColorBrush x:Key="ComboBoxBackgroundFocused" Color="{StaticResource Wp.ControlColor}" />
    <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="#21F2ECE4" />
    <SolidColorBrush x:Key="ComboBoxBackgroundDisabled" Color="{StaticResource Wp.ControlPressedColor}" />
    <SolidColorBrush x:Key="ComboBoxForeground" Color="{StaticResource Wp.LabelColor}" />
    <SolidColorBrush x:Key="ComboBoxForegroundDisabled" Color="{StaticResource Wp.DisabledLabelColor}" />
    <SolidColorBrush x:Key="ComboBoxBorderBrushFocused" Color="{StaticResource Wp.SecondaryLabelColor}" />
    <SolidColorBrush x:Key="ComboBoxBorderBrushDisabled" Color="{StaticResource Wp.StrokeColor}" />
    <SolidColorBrush x:Key="ComboBoxDropDownGlyphForeground" Color="{StaticResource Wp.SecondaryLabelColor}" />
    <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="{StaticResource Wp.CardColor}" />
    <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="{StaticResource Wp.StrokeColor}" />
    <SolidColorBrush x:Key="ComboBoxItemPillFillBrush" Color="{StaticResource Wp.AccentColor}" />
    <SolidColorBrush x:Key="ComboBoxItemBackgroundSelected" Color="{StaticResource Wp.HoverColor}" />
    <SolidColorBrush x:Key="ComboBoxItemForeground" Color="{StaticResource Wp.LabelColor}" />
    <SolidColorBrush x:Key="ComboBoxItemForegroundSelected" Color="{StaticResource Wp.LabelColor}" />

    <!-- 清單（ListBox 預設樣式的選取色原本是實心藍） -->
    <SolidColorBrush x:Key="ListBoxItemForeground" Color="{StaticResource Wp.LabelColor}" />
    <SolidColorBrush x:Key="ListBoxItemSelectedBackgroundThemeBrush" Color="{StaticResource Wp.SurfaceColor}" />
    <SolidColorBrush x:Key="ListBoxItemSelectedForegroundThemeBrush" Color="{StaticResource Wp.LabelColor}" />
    <SolidColorBrush x:Key="ListViewItemPillFillBrush" Color="{StaticResource Wp.AccentColor}" />
    <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="{StaticResource Wp.HoverColor}" />

    <!-- 右鍵選單、提示框 -->
    <SolidColorBrush x:Key="ContextMenuBackground" Color="{StaticResource Wp.CardColor}" />
    <SolidColorBrush x:Key="ContextMenuBorderBrush" Color="{StaticResource Wp.StrokeColor}" />
    <SolidColorBrush x:Key="ContextMenuForeground" Color="{StaticResource Wp.LabelColor}" />
    <SolidColorBrush x:Key="FlyoutBackground" Color="{StaticResource Wp.CardColor}" />
    <SolidColorBrush x:Key="FlyoutBorderBrush" Color="{StaticResource Wp.StrokeColor}" />
    <SolidColorBrush x:Key="ToolTipBackground" Color="{StaticResource Wp.SurfaceColor}" />
    <SolidColorBrush x:Key="ToolTipBorderBrush" Color="{StaticResource Wp.StrokeColor}" />
    <SolidColorBrush x:Key="ToolTipForeground" Color="{StaticResource Wp.LabelColor}" />

    <!-- 捲軸：暖灰滑塊 -->
    <SolidColorBrush x:Key="ScrollBarThumbFill" Color="{StaticResource Wp.TertiaryLabelColor}" />
    <SolidColorBrush x:Key="ScrollBarButtonArrowForeground" Color="{StaticResource Wp.TertiaryLabelColor}" />
    <SolidColorBrush x:Key="ScrollBarButtonBackground" Color="#00000000" />
    <SolidColorBrush x:Key="ScrollBarTrackFillPointerOver" Color="{StaticResource Wp.CardColor}" />

    <!-- 進度條（影片進度）：紅色滑塊與已播放段，象牙白底軌 -->
    <SolidColorBrush x:Key="SliderTrackFill" Color="#4DF2ECE4" />
    <SolidColorBrush x:Key="SliderTrackFillPointerOver" Color="#66F2ECE4" />
    <SolidColorBrush x:Key="SliderTickBarFill" Color="#4DF2ECE4" />
    <SolidColorBrush x:Key="SliderOuterThumbBackground" Color="{StaticResource Wp.SurfaceColor}" />
    <SolidColorBrush x:Key="SliderThumbBackground" Color="{StaticResource Wp.AccentColor}" />
    <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="{StaticResource Wp.AccentHoverColor}" />

    <!-- 載入中的轉圈與進度條 -->
    <SolidColorBrush x:Key="ProgressRingForegroundThemeBrush" Color="{StaticResource Wp.AccentColor}" />
    <SolidColorBrush x:Key="ProgressBarForeground" Color="{StaticResource Wp.AccentColor}" />
    <SolidColorBrush x:Key="ProgressBarBackground" Color="#2EF2ECE4" />

    <!-- ========== 蓋過 WPF 內建的系統色（沒有被 WPF-UI 改樣式的控制項用的反白藍） ========== -->
    <Color x:Key="{x:Static SystemColors.HighlightColorKey}">#5C121C</Color>
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="{StaticResource Wp.VelvetColor}" />
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="{StaticResource Wp.LabelColor}" />
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="{StaticResource Wp.SurfaceColor}" />
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="{StaticResource Wp.LabelColor}" />
    <SolidColorBrush x:Key="{x:Static SystemColors.HotTrackBrushKey}" Color="{StaticResource Wp.SecondaryLabelColor}" />
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuHighlightBrushKey}" Color="{StaticResource Wp.SurfaceColor}" />
</ResourceDictionary>
